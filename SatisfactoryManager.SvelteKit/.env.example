# Local development database (docker compose)
DATABASE_URL="postgres://app:app@localhost:5432/satisfactory"

# Azure AD B2C Configuration
# Copy this file to .env.local and replace the placeholder values with your actual Azure B2C configuration

# Your Application (client) ID from Azure portal
VITE_AZURE_B2C_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_B2C_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Your B2C authority URL - format: https://{tenant}.b2clogin.com/{tenant}.onmicrosoft.com/{policy}
VITE_AZURE_B2C_AUTHORITY=https://yourtenant.b2clogin.com/yourtenant.onmicrosoft.com/B2C_1_SIGNIN_SIGNUP
AZURE_B2C_AUTHORITY=https://yourtenant.b2clogin.com/yourtenant.onmicrosoft.com/B2C_1_SIGNIN_SIGNUP

# Known authorities (your B2C tenant domain)
VITE_AZURE_B2C_KNOWN_AUTHORITY=yourtenant.b2clogin.com
AZURE_B2C_KNOWN_AUTHORITY=yourtenant.b2clogin.com

# Redirect URIs - where users are redirected after authentication
VITE_AZURE_B2C_REDIRECT_URI=http://localhost:5173
AZURE_B2C_REDIRECT_URI=http://localhost:5173
VITE_AZURE_B2C_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
AZURE_B2C_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# Optional: API Configuration
VITE_API_BASE_URL=https://localhost:7001
API_BASE_URL=https://localhost:7001

# Production values (update for your production environment)
# VITE_AZURE_B2C_REDIRECT_URI=https://yourdomain.com
# VITE_AZURE_B2C_POST_LOGOUT_REDIRECT_URI=https://yourdomain.com
# VITE_API_BASE_URL=https://api.yourdomain.com
