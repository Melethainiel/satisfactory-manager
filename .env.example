# ============================================================================
# SATISFACTORY MANAGER - ENVIRONMENT CONFIGURATION
# ============================================================================
# 
# This file provides templates for environment variables used in the Satisfactory
# Manager application. Copy this file to .env.local for development or configure
# these variables in your production environment.
#
# IMPORTANT: Variables prefixed with PUBLIC_ are exposed to the client-side code.
# Never put sensitive information (like secrets or API keys) in PUBLIC_ variables.
#
# Environment Variable Loading Order (highest to lowest priority):
# 1. System environment variables
# 2. .env.local (local overrides, not committed to git)
# 3. .env.[NODE_ENV] (environment-specific, e.g., .env.production)
# 4. .env (default values, committed to git)
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL database connection string
# Format: postgres://username:password@hostname:port/database
# Required for all environments
DATABASE_URL="postgres://app:app@localhost:5432/satisfactory"

# Optional: Test database URL (used in testing environment)
# TEST_DATABASE_URL="postgres://app:app@localhost:5433/satisfactory_test"

# ============================================================================
# AZURE AD B2C AUTHENTICATION - SERVER SIDE (Private)
# ============================================================================
# These variables are only available on the server and are never exposed to clients

# Your Application (client) ID from Azure AD B2C app registration
# Required - Get this from Azure Portal > App registrations > Your app > Overview
AZURE_B2C_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Azure B2C authority URL with your tenant and user flow
# Format: https://{tenant}.b2clogin.com/{tenant}.onmicrosoft.com/{policy}
# Required - Replace 'yourtenant' with your B2C tenant name
AZURE_B2C_AUTHORITY="https://yourtenant.b2clogin.com/yourtenant.onmicrosoft.com/B2C_1_SignInSignUp"

# Known authorities as JSON array (used for token validation)
# Required - List of trusted B2C tenant domains
AZURE_B2C_KNOWN_AUTHORITIES='["yourtenant.b2clogin.com"]'

# Optional: Client secret for server-side token validation (if needed)
# Only use if your app registration requires a client secret
# AZURE_B2C_CLIENT_SECRET="your-client-secret-here"

# Optional: Additional server-side authentication configuration
# AZURE_B2C_TENANT_ID="your-tenant-id"
# AZURE_B2C_POLICY="B2C_1_SignInSignUp"
# AZURE_B2C_API_SCOPE="access_users"

# ============================================================================
# AZURE AD B2C AUTHENTICATION - CLIENT SIDE (Public)
# ============================================================================
# These variables are exposed to the browser and must be prefixed with PUBLIC_

# Client ID for browser-based authentication (same as server-side)
# Required - Must match AZURE_B2C_CLIENT_ID
PUBLIC_AZURE_B2C_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Authority URL for browser-based authentication (same as server-side)  
# Required - Must match AZURE_B2C_AUTHORITY
PUBLIC_AZURE_B2C_AUTHORITY="https://yourtenant.b2clogin.com/yourtenant.onmicrosoft.com/B2C_1_SignInSignUp"

# Known authorities for browser validation (same as server-side)
# Required - Must match AZURE_B2C_KNOWN_AUTHORITIES
PUBLIC_AZURE_B2C_KNOWN_AUTHORITIES='["yourtenant.b2clogin.com"]'

# Optional: Custom redirect URIs (default: window.location.origin)
# Where users are redirected after successful authentication
# PUBLIC_AZURE_B2C_REDIRECT_URI="http://localhost:5173/auth/callback"

# Where users are redirected after logout
# PUBLIC_AZURE_B2C_POST_LOGOUT_REDIRECT_URI="http://localhost:5173"

# Optional: Custom API scope for client-side requests
# PUBLIC_AZURE_B2C_API_USER_ACCESS_SCOPE="https://yourtenant.onmicrosoft.com/api/access_users"

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Optional: Server-side API base URL (for server-to-server calls)
# API_BASE_URL="https://api.yourdomain.com"

# Optional: Client-side API base URL (exposed to browser)
# PUBLIC_API_BASE_URL="https://api.yourdomain.com"

# Optional: Application name (displayed in UI)
# PUBLIC_APP_NAME="Satisfactory Manager"

# ============================================================================
# RUNTIME ENVIRONMENT
# ============================================================================

# Application environment (automatically set by most deployment platforms)
# Possible values: development, production, test
# NODE_ENV="development"

# ============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# ============================================================================

# Optional: Log level for development
# PUBLIC_LOG_LEVEL="info"
# VITE_TEST_LOG_LEVEL="warn"

# ============================================================================
# PRODUCTION ENVIRONMENT EXAMPLES
# ============================================================================
# Uncomment and modify these for production deployment:

# Production database (replace with your production connection string)
# DATABASE_URL="postgres://username:password@your-db-host:5432/satisfactory"

# Production authentication URLs
# PUBLIC_AZURE_B2C_REDIRECT_URI="https://yourdomain.com/auth/callback"
# PUBLIC_AZURE_B2C_POST_LOGOUT_REDIRECT_URI="https://yourdomain.com"

# Production API endpoints  
# PUBLIC_API_BASE_URL="https://api.yourdomain.com"
# API_BASE_URL="https://api.yourdomain.com"

# ============================================================================
# VALIDATION NOTES
# ============================================================================
# 
# The application will validate these environment variables on startup:
# 
# ✅ Required variables will cause startup to fail if missing
# ⚠️  Optional variables will use fallbacks if not provided  
# 🔒 Private variables are never exposed to the client
# 🌐 Public variables are embedded in the client-side bundle
#
# Run the application to see detailed validation messages.
# ============================================================================
