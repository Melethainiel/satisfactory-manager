{
	"name": "satisfactorymanager.sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"generate": "drizzle-kit generate --out drizzle",
		"test": "vitest",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:docker": "npm run test:docker:setup && npm run test:integration; npm run test:docker:cleanup",
		"test:docker:setup": "docker compose up -d postgres-test && node scripts/wait-for-db.js",
		"test:docker:cleanup": "docker compose stop postgres-test",
		"test:docker:down": "docker compose down postgres-test",
		"test:docker:logs": "docker compose logs postgres-test",
		"test:components": "vitest run tests/components",
		"test:components:watch": "vitest watch tests/components",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:accessibility": "playwright test tests/e2e/accessibility",
		"test:e2e:full": "npm run test:docker:setup && concurrently --kill-others --success first 'npm run dev' 'npm run test:e2e:wait' && npm run test:docker:cleanup",
		"test:e2e:wait": "wait-on http://localhost:5173 && npm run test:e2e",
		"test:all": "npm run test:run && npm run test:e2e:full",
		"test:ci": "npm run test:coverage && npm run test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.2",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.55.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-node": "^5.3.1",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/svelte": "^5.2.8",
		"@testing-library/user-event": "^14.6.1",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20",
		"@types/yauzl-promise": "^4.0.1",
		"@vitest/ui": "^3.2.4",
		"axe-playwright": "^2.1.0",
		"concurrently": "^9.2.1",
		"dotenv": "^16.6.1",
		"drizzle-kit": "^0.30.6",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"happy-dom": "^18.0.1",
		"jsdom": "^26.1.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-hero-icons": "^5.2.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4",
		"vite-plugin-devtools-json": "^0.4.1",
		"vitest": "^3.2.4",
		"wait-on": "^8.0.4"
	},
	"dependencies": {
		"@azure/identity": "^4.11.1",
		"@azure/msal-browser": "^4.19.0",
		"@types/tmp": "^0.2.6",
		"@types/uuid": "^10.0.0",
		"@types/ws": "^8.18.1",
		"daisyui": "^5.0.50",
		"drizzle-orm": "^0.40.0",
		"jose": "^5.9.3",
		"js-yaml": "^4.1.0",
		"postgres": "^3.4.5",
		"svelte-i18n": "^4.0.1",
		"tmp": "^0.2.5",
		"uuid": "^11.1.0",
		"ws": "^8.18.3",
		"yauzl-promise": "^4.0.0",
		"zod": "^4.1.1"
	}
}
